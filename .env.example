# ───── الخادم ─────
PORT=3000
# رابط عمومي للخادم (يُستعمل لعرض روابط الـwebhook في اللوحة)
PUBLIC_URL=http://localhost:3000
# مسار قاعدة البيانات (SQLite دائمة)
DB_PATH=./data/zinor.db
# مفتاح تشفير مفاتيح الربط (32 بايت hex). إذا ما حطيتوش يتولّد واحد في data/.secret-key
APP_SECRET_KEY=

# ───── واتساب Business Cloud API ─────
# بلا هاذو كل الرسائل تتسجّل "محاكاة" وتبان في محاكي واتساب في اللوحة
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=zinor-verify
WA_GRAPH_VERSION=v21.0
WA_TEMPLATE_LANG=ar

# ───── الذكاء الاصطناعي (Claude) ─────
# بلا مفتاح يخدم المحرّك المحلي (محاكاة قواعد للدارجة)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# ───── التحقق الدوري من حالة الشحنات (دقائق) ─────
POLL_INTERVAL_MIN=15

# ───── المكالمات (Twilio عبر n8n) — المكالمات الحقيقية مطفية افتراضياً، تتفعّل من اللوحة ─────
# n8n: Webhook "Zinor: طلب مكالمة" (production URL)
N8N_CALL_START_URL=
# n8n: Webhook "Twilio: كلام الزبون" — يتحط في <Gather action> وفي رقم Twilio للمكالمات الواردة (?direction=inbound)
N8N_CALL_TURN_URL=
# سرّ مشترك بين Zinor و n8n (نفس القيمة في n8n) — ولّد واحد طويل: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLS_WEBHOOK_SECRET=
# لغة التعرّف على الكلام عند Twilio (لازم تتجرّب: ar-DZ)
CALLS_SPEECH_LANGUAGE=ar-DZ
CALLS_SCHEDULER_SECONDS=30

# ───── ElevenLabs (اختياري): أصوات أقرب للدارجة + استنساخ الصوت ─────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ───── SpyBox Gemini TTS (صوت Puck…) — المفتاح يبقى على الخادم ─────
# المفتاح من SpyBox Crea → Settings → API & MCP (sbx_live_…)
SPYBOX_API_KEY=
SPYBOX_BASE_URL=https://spybox-crea.vercel.app/api/v1
SPYBOX_MODEL=gemini-tts
# أقصى وقت نستناو التوليد وسط مكالمة حقيقية قبل ما نرجعو لـ <Say> (Twilio يستنى ~15 ثانية)
SPYBOX_CALL_BUDGET_MS=8000
SPYBOX_TIMEOUT_SEC=90
